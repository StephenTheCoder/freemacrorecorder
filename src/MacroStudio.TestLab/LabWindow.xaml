<Window x:Class="MacroStudio.TestLab.LabWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MacroStudio Interaction Lab" Width="800" Height="670" WindowStartupLocation="CenterScreen" Background="#F1F4F8" FontFamily="Segoe UI" FontSize="15">
 <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/><RowDefinition Height="150"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel><TextBlock Text="Interaction lab" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="A local, repeatable target for MacroStudio recordings." Margin="0,6,0,18"/></StackPanel><StackPanel Grid.Row="1"><Label Target="{Binding ElementName=Entry}" Content="Text and shortcuts"/><TextBox x:Name="Entry" Height="42" Padding="8" AutomationProperties.AutomationId="LabText"/><TextBox x:Name="SecondEntry" Height="36" Margin="0,8" Padding="6" AutomationProperties.Name="Second text field"/></StackPanel><StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8"><Button x:Name="Counter" Content="Click counter: 0" Padding="18,8" Click="Count" AutomationProperties.AutomationId="LabCounter"/><Button x:Name="ResetButton" Content="Reset lab" Padding="18,8" Margin="10,0" Click="Reset"/><TextBlock x:Name="Keys" VerticalAlignment="Center" Margin="10,0"/></StackPanel><ScrollViewer x:Name="Scroller" Grid.Row="3" VerticalScrollBarVisibility="Visible" Background="White" Margin="0,8"><StackPanel x:Name="ScrollItems"/></ScrollViewer><Canvas x:Name="DragCanvas" Grid.Row="4" Background="#DFE8F5" Margin="0,8" MouseMove="DragMove" MouseLeftButtonUp="DragUp"><TextBlock Text="Drag the blue square into the outlined target" Canvas.Left="12" Canvas.Top="10"/><Border x:Name="DropTarget" Width="100" Height="70" Canvas.Left="480" Canvas.Top="50" BorderThickness="2" BorderBrush="#5073A0"/><Border x:Name="Draggable" Width="65" Height="65" Background="#245CD6" Canvas.Left="30" Canvas.Top="50" MouseLeftButtonDown="DragDown"/></Canvas><TextBlock x:Name="Events" Grid.Row="5" Text="Ready · no network or external effects" TextWrapping="Wrap"/></Grid>
</Window>
