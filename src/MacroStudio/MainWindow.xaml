<Window x:Class="MacroStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Background="{DynamicResource Bg}" Foreground="{DynamicResource Ink}" FontFamily="Segoe UI" FontSize="13" Width="1320" Height="810" MinWidth="1000" MinHeight="600" WindowStartupLocation="CenterScreen" Closing="OnClosing" PreviewKeyDown="OnKeyDown">
 <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Background="{DynamicResource Panel}" Margin="0,0,0,1">
   <StackPanel Orientation="Horizontal" Margin="18,14"><Border Background="{DynamicResource Accent}" CornerRadius="7" Padding="9,5"><TextBlock Text="M" Foreground="White" FontWeight="Bold" FontSize="18"/></Border><StackPanel Margin="10,0"><TextBlock Text="MacroStudio" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="DESKTOP AUTOMATION" Foreground="{DynamicResource Muted}" FontSize="10"/></StackPanel></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="10"><Button Content="Interaction lab" Click="OpenLab"/><Button Content="Shortcuts" Click="ConfigureHotkeys"/><Button Content="Light / dark" Click="ToggleTheme"/><Button Content="Help" Click="ShowHelp"/></StackPanel>
  </DockPanel>
  <StackPanel Grid.Row="1" Background="{DynamicResource Panel}">
   <Menu><MenuItem Header="_File"><MenuItem Header="_New" InputGestureText="Ctrl+N" Click="NewFile"/><MenuItem Header="_Open…" InputGestureText="Ctrl+O" Click="OpenFile"/><MenuItem Header="_Save" InputGestureText="Ctrl+S" Click="SaveFile"/><MenuItem Header="Save _as…" Click="SaveAs"/><Separator/><MenuItem x:Name="RecentMenu" Header="Recent files"/></MenuItem><MenuItem Header="_Edit"><MenuItem Header="Undo" Click="Undo"/><MenuItem Header="Redo" Click="Redo"/><Separator/><MenuItem Header="Cut" Click="Cut"/><MenuItem Header="Copy" Click="Copy"/><MenuItem Header="Paste" Click="Paste"/><MenuItem Header="Duplicate" Click="Duplicate"/><MenuItem Header="Delete" Click="Delete"/></MenuItem><MenuItem Header="_Playback"><MenuItem Header="Play one action" Click="PlayOne"/><MenuItem Header="Play selected range" Click="PlayRange"/><MenuItem Header="Play from selection" Click="PlayFrom"/></MenuItem></Menu>
   <DockPanel Margin="16,7,16,12">
    <StackPanel Orientation="Horizontal"><Button Content="●  Record" Background="#B62540" Foreground="White" BorderBrush="#B62540" FontWeight="SemiBold" Click="Record" IsEnabled="{Binding Idle}" ToolTip="Start explicit system-wide recording"/><Button Content="■  Stop" Click="Stop" ToolTip="Stop recording or cancel playback and release held inputs"/><Button Content="▶  Play" Background="{DynamicResource Accent}" Foreground="White" Click="Play" IsEnabled="{Binding Idle}"/><Button Content="Ⅱ  Pause / resume" Click="Pause"/><Separator Width="12"/><Button Content="Undo" Click="Undo" IsEnabled="{Binding Idle}"/><Button Content="Redo" Click="Redo" IsEnabled="{Binding Idle}"/></StackPanel>
    <TextBlock x:Name="HotkeyHint" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/>
   </DockPanel>
  </StackPanel>
  <Border Grid.Row="2" Margin="18,12" Padding="12,8" Background="{DynamicResource Panel}" CornerRadius="7" BorderBrush="{DynamicResource Line}" BorderThickness="1" IsEnabled="{Binding Idle}"><WrapPanel VerticalAlignment="Center"><TextBlock Text="PLAYBACK" FontWeight="SemiBold" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock Text="Speed ×" VerticalAlignment="Center"/><TextBox Text="{Binding Speed, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" Width="58" Margin="6,0,16,0" AutomationProperties.Name="Playback speed multiplier" ToolTip="0.05 to 100 times recorded speed"/><TextBlock Text="Repeat" VerticalAlignment="Center"/><TextBox Text="{Binding Repetitions, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" Width="62" Margin="6,0,12,0" AutomationProperties.Name="Repetition count" ToolTip="1 to 1000000 repetitions"/><CheckBox Content="Until stopped" IsChecked="{Binding UntilStopped}"/><CheckBox Content="Skip mouse paths" IsChecked="{Binding SkipPaths}"/><CheckBox Content="Restore window bounds" IsChecked="{Binding RestoreWindows}"/></WrapPanel></Border>
  <Grid Grid.Row="3" Margin="18,0,18,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="294"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Panel}" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="12,10"><TextBlock Text="Action sequence" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="12,0,0,0" HorizontalAlignment="Right" AutomationProperties.Name="Search actions" ToolTip="Search actions, windows, and comments"/></DockPanel>
    <DataGrid x:Name="ActionGrid" Grid.Row="1" ItemsSource="{Binding Rows}" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow" CanUserAddRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionChanged="OnSelectionChanged" AllowDrop="True" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" Drop="DropRows" MouseDoubleClick="EditSelected" AutomationProperties.Name="Macro action sequence">
     <DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Number}" Width="42"/><DataGridCheckBoxColumn Header="On" Binding="{Binding Enabled, Mode=OneWay}" Width="40"/><DataGridTextColumn Header="Action" Binding="{Binding Kind}" Width="100"/><DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2*"/><DataGridTextColumn Header="Delay / duration" Binding="{Binding Timing}" Width="130"/><DataGridTextColumn Header="Target window" Binding="{Binding Target}" Width="*"/><DataGridTextColumn Header="Comment" Binding="{Binding Comment}" Width="*"/></DataGrid.Columns>
    </DataGrid>
    <WrapPanel Grid.Row="2" Margin="8" IsEnabled="{Binding Idle}"><Button Content="+ Insert" Click="Insert"/><Button Content="Duplicate" Click="Duplicate"/><Button Content="Delete" Click="Delete"/><Button Content="Enable / disable" Click="ToggleEnabled"/><Button Content="↑" Click="MoveUp" ToolTip="Move selection up" AutomationProperties.Name="Move selection up"/><Button Content="↓" Click="MoveDown" ToolTip="Move selection down" AutomationProperties.Name="Move selection down"/></WrapPanel>
   </Grid></Border>
   <Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="8" BorderBrush="{DynamicResource Line}" BorderThickness="1"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18"><TextBlock Text="Step properties" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Select a step to inspect or edit it." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,6,0,16"/><TextBlock x:Name="InspectorType" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="InspectorDescription" TextWrapping="Wrap" Margin="0,8"/><TextBlock x:Name="InspectorTarget" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/><Button Content="Edit properties…" Click="EditSelected" Margin="0,18,0,6" IsEnabled="{Binding Idle}"/><Button Content="Play this action" Click="PlayOne" Margin="0,3" IsEnabled="{Binding Idle}"/><Button Content="Play selected range" Click="PlayRange" Margin="0,3" IsEnabled="{Binding Idle}"/><Button Content="Play from selection" Click="PlayFrom" Margin="0,3" IsEnabled="{Binding Idle}"/><Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Margin="0,22,0,16"/><TextBlock Text="RECORDING COORDINATES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Muted}"/><ComboBox x:Name="CoordinatePicker" SelectedIndex="0" IsEnabled="{Binding Idle}" Margin="0,10"><ComboBoxItem Content="Physical desktop pixels"/><ComboBoxItem Content="Relative to target window"/></ComboBox><TextBlock Text="Mouse paths are grouped between input events. Key and button down/up pairs preserve shortcuts, double-clicks and held drags." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8"/><TextBlock Text="Local files · explicit recording" FontWeight="SemiBold" Margin="0,16,0,0"/></StackPanel></ScrollViewer></Border>
  </Grid>
  <Border Grid.Row="4" Background="{DynamicResource Panel}" Padding="18,10" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"><DockPanel><TextBlock Text="{Binding Summary}" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}"/><TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/></DockPanel></Border>
 </Grid>
</Window>

